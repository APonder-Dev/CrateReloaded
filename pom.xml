<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <packaging>pom</packaging>

  <groupId>com.hazebyte</groupId>
  <artifactId>crate</artifactId>
  <version>2.4.0</version>

  <name>Crate</name>
  <url>http://crate.hazebyte.com/</url>
  <modules>
    <module>bukkit</module>
    <module>nms</module>
    <module>api</module>
    <module>utils</module>
    <module>common</module>
    <module>effectlib</module>
    <module>cmi-stub</module>
  </modules>

  <properties>
    <!-- Build family defaults = Minecraft 26.x (profile mc26). See the mc121 / mc120 profiles below
         and COMPATIBILITY-MATRIX.md. Each family compiles against the LOWEST Paper API it claims. -->
    <crate.family>mc26</crate.family>
    <!-- Minecraft range the family claims (checked at startup by compat.BuildFamily). -->
    <crate.minecraft.min>26.1</crate.minecraft.min>
    <crate.minecraft.max>26.3</crate.minecraft.max>
    <java.version>25</java.version>
    <!-- 26.3 build 249: newest build MockBukkit 4.124.0 loads (build 261 adds registries MockBukkit lacks).
         The main code also compiles against 26.3.build.261-stable; that check runs in CI. -->
    <paper.api.version>26.3.build.249-stable</paper.api.version>
    <!-- Newest API of the family that MockBukkit supports. The build scripts run the test suite a second
         time with -Dpaper.api.version=${paper.ceiling.api.version}; the shipped jar is always the floor build. -->
    <paper.ceiling.api.version>26.3.build.249-stable</paper.ceiling.api.version>
    <plugin.api.version>26.1</plugin.api.version>
    <mockbukkit.artifact>mockbukkit-v26.3</mockbukkit.artifact>
    <mockbukkit.version>4.124.0</mockbukkit.version>
    <!-- MockBukkit 4.x exists only for 1.21+ / 26.x; the 1.20 family skips the server-mock test suite. -->
    <crate.skipServerTests>false</crate.skipServerTests>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <mapstruct.version>1.6.3</mapstruct.version>
  </properties>

  <repositories>
    <repository>
      <id>aikar</id>
      <name>ACF - https://github.com/aikar/commands</name>
      <url>https://repo.aikar.co/content/groups/aikar/</url>
    </repository>
    <repository>
      <id>extendedclip</id>
      <name>Placeholder API - https://www.spigotmc.org/resources/placeholderapi.6245/</name>
      <url>https://repo.extendedclip.com/releases/</url>
    </repository>
    <repository>
      <id>codemc</id>
      <name>CodeMC</name>
      <url>https://repo.codemc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>spigot</id>
      <name>Spigot API</name>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
    <!-- com.mojang:authlib -->
    <repository>
      <id>minecraft-libraries</id>
      <name>Minecraft Libraries</name>
      <url>https://libraries.minecraft.net/</url>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.hazebyte.crate</groupId>
        <artifactId>nms</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hazebyte.crate</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.46</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.dagger</groupId>
      <artifactId>dagger</artifactId>
      <version>2.60</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.23.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>5.23.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
            <release>${java.version}</release>
            <annotationProcessorPaths>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.46</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>0.2.0</version>
              </path>
              <path>
                <groupId>com.google.dagger</groupId>
                <artifactId>dagger-compiler</artifactId>
                <version>2.60</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>2.5.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>2.8.2</version>
        </plugin>
        <!-- site lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#site_Lifecycle -->
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.12.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>3.7.0</version>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>compile</phase>
            </execution>
          </executions>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>

              <palantirJavaFormat>
                <!-- Optionally specify a version -->
                <version>2.94.0</version>
              </palantirJavaFormat>
              <removeUnusedImports />
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>4.7.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.15</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Minecraft 26.1 - 26.3, Java 25. Default. -->
    <profile>
      <id>mc26</id>
      <activation><activeByDefault>true</activeByDefault></activation>
    </profile>
    <!-- Minecraft 1.21 - 1.21.11, Java 21. Compiled against the lowest API of the family. -->
    <profile>
      <id>mc121</id>
      <properties>
        <crate.family>mc121</crate.family>
        <crate.minecraft.min>1.21</crate.minecraft.min>
        <crate.minecraft.max>1.21.11</crate.minecraft.max>
        <java.version>21</java.version>
        <paper.api.version>1.21.1-R0.1-SNAPSHOT</paper.api.version>
        <paper.ceiling.api.version>1.21.11-R0.1-SNAPSHOT</paper.ceiling.api.version>
        <plugin.api.version>1.21</plugin.api.version>
        <mockbukkit.artifact>mockbukkit-v1.21</mockbukkit.artifact>
        <mockbukkit.version>4.116.3</mockbukkit.version>
      </properties>
    </profile>
    <!-- Minecraft 1.20.1 - 1.20.4, Java 17. -->
    <profile>
      <id>mc120</id>
      <properties>
        <crate.family>mc120</crate.family>
        <crate.minecraft.min>1.20.1</crate.minecraft.min>
        <crate.minecraft.max>1.20.6</crate.minecraft.max>
        <java.version>17</java.version>
        <paper.api.version>1.20.1-R0.1-SNAPSHOT</paper.api.version>
        <paper.ceiling.api.version>1.20.4-R0.1-SNAPSHOT</paper.ceiling.api.version>
        <plugin.api.version>1.20</plugin.api.version>
        <mockbukkit.artifact>mockbukkit-v1.21</mockbukkit.artifact>
        <mockbukkit.version>4.116.3</mockbukkit.version>
        <crate.skipServerTests>true</crate.skipServerTests>
      </properties>
    </profile>
  </profiles>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <configLocation>build-tools/src/main/resources/build/checkstyle.xml</configLocation>
          <headerLocation>build-tools/src/main/resources/build/LICENSE.txt</headerLocation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.7.2.0</version>
        <configuration>
          <effort>Max</effort>
          <threshold>High</threshold>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
      </plugin>
    </plugins>
  </reporting>

</project>
