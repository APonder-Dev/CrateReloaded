<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- In-tree fork of elBukkit/EffectLib (MIT): the EffectLib core plus a Compatibility layer of
       version-specific particle backends. The core compiles against the build family's Paper API, isolated from the
       reactor's other provided deps. See LICENSE for attribution. -->
  <groupId>com.elmakers.mine.bukkit</groupId>
  <artifactId>EffectLib-parent</artifactId>
  <version>11.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>EffectLib-parent</name>
  <description>Particle effect library for Bukkit (fork, maintained in-tree for CrateReloaded).</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The core follows the CrateReloaded build family (same profile ids as the root POM: mc26 / mc121 /
         mc120). The Compatibility backends always target Java 17 and are selected at runtime. -->
    <maven.compiler.release>25</maven.compiler.release>
    <effectlib.paper.api.version>26.3.build.249-stable</effectlib.paper.api.version>
  </properties>

  <profiles>
    <profile>
      <id>mc26</id>
      <activation><activeByDefault>true</activeByDefault></activation>
    </profile>
    <profile>
      <id>mc121</id>
      <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <effectlib.paper.api.version>1.21.1-R0.1-SNAPSHOT</effectlib.paper.api.version>
      </properties>
    </profile>
    <profile>
      <id>mc120</id>
      <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <effectlib.paper.api.version>1.20.1-R0.1-SNAPSHOT</effectlib.paper.api.version>
      </properties>
    </profile>
  </profiles>

  <modules>
    <module>Compatibility</module>
    <module>EffectLib</module>
  </modules>

  <repositories>
    <repository>
      <id>spigot</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <!-- com.elmakers.math:exp4j (elMakers' exp4j fork) is published only here, not on Maven Central. -->
    <repository>
      <id>aikar</id>
      <url>https://repo.aikar.co/content/groups/aikar/</url>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
